SERVER_ADDRESS="localhost:8080"
DATABASE_PATH="marketplace.db"
JWT_SECRET="your_jwt_secret_here"
SESSION_COOKIE_NAME="session_token"
OBJECT_STORE_PROVIDER="unavailable"
# For S3-backed images, set OBJECT_STORE_PROVIDER="s3" and configure:
# S3_BUCKET="your-private-image-bucket"
# AWS_REGION="us-east-1"
# AWS_PROFILE="your-local-aws-profile"
